from datetime import datetime, timezone


# ============================================================
# SETTINGS
# ============================================================

DEFAULT_BALANCE = 1000.0

MAX_OPEN_POSITIONS = 5


# ============================================================
# PAPER ENGINE
# ============================================================

class PaperTradingEngine:

    def __init__(
        self,
        initial_balance=DEFAULT_BALANCE,
    ):

        self.initial_balance = float(
            initial_balance
        )

        self.balance = float(
            initial_balance
        )

        self.open_positions = []

        self.closed_positions = []

        self.trade_counter = 0

    # ========================================================
    # TIME
    # ========================================================

    @staticmethod
    def _now():

        return datetime.now(
            timezone.utc
        ).isoformat()

    # ========================================================
    # POSITION ID
    # ========================================================

    def _new_trade_id(self):

        self.trade_counter += 1

        return (
            f"PAPER-{self.trade_counter:06d}"
        )

    # ========================================================
    # FIND POSITION
    # ========================================================

    def get_position(
        self,
        symbol,
    ):

        for position in self.open_positions:

            if position["symbol"] == symbol:

                return position

        return None

    # ========================================================
    # OPEN POSITION
    # ========================================================

    def open_position(
        self,
        signal,
    ):

        if not signal:
            return None

        symbol = signal.get(
            "symbol"
        )

        side = signal.get(
            "side"
        )

        entry = signal.get(
            "entry"
        )

        stop = signal.get(
            "stop"
        )

        tp1 = signal.get(
            "tp1"
        )

        tp2 = signal.get(
            "tp2"
        )

        quantity = signal.get(
            "quantity"
        )

        if not symbol:
            return None

        if side not in (
            "LONG",
            "SHORT",
            "BUY",
        ):

            return None

        if (
            entry is None
            or stop is None
        ):

            return None

        try:

            entry = float(entry)
            stop = float(stop)

            if tp1 is not None:
                tp1 = float(tp1)

            if tp2 is not None:
                tp2 = float(tp2)

            if quantity is not None:
                quantity = float(quantity)

        except (
            TypeError,
            ValueError,
        ):

            return None

        # ----------------------------------------------------
        # BUY -> LONG
        # ----------------------------------------------------

        if side == "BUY":
            side = "LONG"

        # ----------------------------------------------------
        # DUPLICATE CHECK
        # ----------------------------------------------------

        existing = self.get_position(
            symbol
        )

        if existing is not None:

            return None

        # ----------------------------------------------------
        # MAX POSITIONS
        # ----------------------------------------------------

        if len(
            self.open_positions
        ) >= MAX_OPEN_POSITIONS:

            return None

        # ----------------------------------------------------
        # QUANTITY
        # ----------------------------------------------------

        if (
            quantity is None
            or quantity <= 0
        ):

            return None

        # ----------------------------------------------------
        # NOTIONAL
        # ----------------------------------------------------

        notional = (
            quantity * entry
        )

        # ----------------------------------------------------
        # TRADE
        # ----------------------------------------------------

        trade = {

            "trade_id":
                self._new_trade_id(),

            "symbol":
                symbol,

            "market":
                signal.get(
                    "market",
                    "UNKNOWN"
                ),

            "side":
                side,

            "entry":
                entry,

            "stop":
                stop,

            "tp1":
                tp1,

            "tp2":
                tp2,

            "quantity":
                quantity,

            "notional":
                notional,

            "opened_at":
                self._now(),

            "status":
                "OPEN",

            "tp1_hit":
                False,

            "realized_pnl":
                0.0,

            "unrealized_pnl":
                0.0,

            "score":
                signal.get(
                    "score",
                    0
                ),

            "confidence":
                signal.get(
                    "confidence",
                    0
                ),

            "reasons":
                signal.get(
                    "reasons",
                    []
                ),

        }

        self.open_positions.append(
            trade
        )

        return trade

    # ========================================================
    # PNL
    # ========================================================

    @staticmethod
    def calculate_pnl(
        position,
        current_price,
    ):

        entry = float(
            position["entry"]
        )

        quantity = float(
            position["quantity"]
        )

        side = position["side"]

        current_price = float(
            current_price
        )

        if side == "LONG":

            return (
                current_price -
                entry
            ) * quantity

        if side == "SHORT":

            return (
                entry -
                current_price
            ) * quantity

        return 0.0

    # ========================================================
    # TP1
    # ========================================================

    def _check_tp1(
        self,
        position,
        current_price,
    ):

        tp1 = position.get(
            "tp1"
        )

        if tp1 is None:
            return False

        if position[
            "tp1_hit"
        ]:

            return False

        side = position[
            "side"
        ]

        if (
            side == "LONG"
            and current_price >= tp1
        ):

            return True

        if (
            side == "SHORT"
            and current_price <= tp1
        ):

            return True

        return False

    # ========================================================
    # STOP
    # ========================================================

    def _check_stop(
        self,
        position,
        current_price,
    ):

        stop = position.get(
            "stop"
        )

        if stop is None:
            return False

        side = position[
            "side"
        ]

        if (
            side == "LONG"
            and current_price <= stop
        ):

            return True

        if (
            side == "SHORT"
            and current_price >= stop
        ):

            return True

        return False

    # ========================================================
    # TP2
    # ========================================================

    def _check_tp2(
        self,
        position,
        current_price,
    ):

        tp2 = position.get(
            "tp2"
        )

        if tp2 is None:
            return False

        side = position[
            "side"
        ]

        if (
            side == "LONG"
            and current_price >= tp2
        ):

            return True

        if (
            side == "SHORT"
            and current_price <= tp2
        ):

            return True

        return False

    # ========================================================
    # UPDATE PRICE
    # ========================================================

    def update_price(
        self,
        symbol,
        current_price,
    ):

        current_price = float(
            current_price
        )

        position = self.get_position(
            symbol
        )

        if position is None:
            return None

        # ----------------------------------------------------
        # UNREALIZED PNL
        # ----------------------------------------------------

        pnl = self.calculate_pnl(
            position,
            current_price
        )

        position[
            "unrealized_pnl"
        ] = pnl

        # ----------------------------------------------------
        # STOP FIRST
        # ----------------------------------------------------

        if self._check_stop(
            position,
            current_price
        ):

            return self.close_position(
                symbol,
                current_price,
                "STOP"
            )

        # ----------------------------------------------------
        # TP2
        # ----------------------------------------------------

        if self._check_tp2(
            position,
            current_price
        ):

            return self.close_position(
                symbol,
                current_price,
                "TP2"
            )

        # ----------------------------------------------------
        # TP1
        # ----------------------------------------------------

        if self._check_tp1(
            position,
            current_price
        ):

            position[
                "tp1_hit"
            ] = True

            # TP1 görüldüğünde SL'yi
            # entry seviyesine çek.
            position[
                "stop"
            ] = position[
                "entry"
            ]

            return {
                "event":
                    "TP1",

                "symbol":
                    symbol,

                "price":
                    current_price,

                "trade_id":
                    position[
                        "trade_id"
                    ],

                "new_stop":
                    position[
                        "stop"
                    ],

            }

        return {
            "event":
                "UPDATE",

            "symbol":
                symbol,

            "price":
                current_price,

            "unrealized_pnl":
                pnl,

            "trade_id":
                position[
                    "trade_id"
                ],

        }

    # ========================================================
    # CLOSE
    # ========================================================

    def close_position(
        self,
        symbol,
        exit_price,
        reason="MANUAL",
    ):

        position = self.get_position(
            symbol
        )

        if position is None:
            return None

        exit_price = float(
            exit_price
        )

        pnl = self.calculate_pnl(
            position,
            exit_price
        )

        position[
            "exit"
        ] = exit_price

        position[
            "realized_pnl"
        ] = pnl

        position[
            "unrealized_pnl"
        ] = 0.0

        position[
            "closed_at"
        ] = self._now()

        position[
            "close_reason"
        ] = reason

        position[
            "status"
        ] = "CLOSED"

        # ----------------------------------------------------
        # BALANCE
        # ----------------------------------------------------

        self.balance += pnl

        # ----------------------------------------------------
        # MOVE TO HISTORY
        # ----------------------------------------------------

        self.open_positions = [
            x
            for x in self.open_positions
            if x["trade_id"]
            != position["trade_id"]
        ]

        self.closed_positions.append(
            position
        )

        return position

    # ========================================================
    # CLOSE ALL
    # ========================================================

    def close_all(
        self,
        prices,
        reason="MANUAL",
    ):

        results = []

        for position in list(
            self.open_positions
        ):

            symbol = position[
                "symbol"
            ]

            price = prices.get(
                symbol
            )

            if price is None:
                continue

            result = self.close_position(
                symbol,
                price,
                reason
            )

            if result:
                results.append(
                    result
                )

        return results

    # ========================================================
    # UPDATE ALL
    # ========================================================

    def update_all(
        self,
        prices,
    ):

        results = []

        for position in list(
            self.open_positions
        ):

            symbol = position[
                "symbol"
            ]

            price = prices.get(
                symbol
            )

            if price is None:
                continue

            result = self.update_price(
                symbol,
                price
            )

            if result:
                results.append(
                    result
                )

        return results

    # ========================================================
    # OPEN POSITIONS
    # ========================================================

    def get_open_positions(
        self
    ):

        return list(
            self.open_positions
        )

    # ========================================================
    # TRADE HISTORY
    # ========================================================

    def get_history(
        self
    ):

        return list(
            self.closed_positions
        )

    # ========================================================
    # STATS
    # ========================================================

    def statistics(
        self
    ):

        trades = (
            self.closed_positions
        )

        total = len(
            trades
        )

        if total == 0:

            return {

                "initial_balance":
                    self.initial_balance,

                "balance":
                    self.balance,

                "total_trades":
                    0,

                "wins":
                    0,

                "losses":
                    0,

                "win_rate":
                    0.0,

                "total_pnl":
                    0.0,

            }

        wins = sum(
            1
            for trade in trades
            if trade[
                "realized_pnl"
            ] > 0
        )

        losses = sum(
            1
            for trade in trades
            if trade[
                "realized_pnl"
            ] < 0
        )

        total_pnl = sum(
            trade[
                "realized_pnl"
            ]
            for trade in trades
        )

        win_rate = (
            wins / total
        ) * 100

        return {

            "initial_balance":
                self.initial_balance,

            "balance":
                self.balance,

            "total_trades":
                total,

            "wins":
                wins,

            "losses":
                losses,

            "win_rate":
                win_rate,

            "total_pnl":
                total_pnl,

        }

    # ========================================================
    # REPORT
    # ========================================================

    def report(
        self
    ):

        stats = self.statistics()

        print()
        print("=" * 70)
        print(
            "PAPER TRADING REPORT"
        )
        print("=" * 70)

        print(
            f"Balance       : "
            f"${stats['balance']:.2f}"
        )

        print(
            f"Total trades  : "
            f"{stats['total_trades']}"
        )

        print(
            f"Wins          : "
            f"{stats['wins']}"
        )

        print(
            f"Losses        : "
            f"{stats['losses']}"
        )

        print(
            f"Win rate      : "
            f"{stats['win_rate']:.2f}%"
        )

        print(
            f"Total PnL     : "
            f"${stats['total_pnl']:.2f}"
        )

        print(
            f"Open positions: "
            f"{len(self.open_positions)}"
        )

        print("=" * 70)
